{
  "name": "praca-web",
  "private": true,
  "packageManager": "npm@10",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --root web",
    "build": "astro build --root web && pagefind --site web/dist",
    "preview": "astro preview --root web",
    "check": "astro check --root web",
    "test:web": "vitest run",
