      "additionalProperties": false,
      "properties": {
        "noticia_id": {
          "title": "Noticia Id",
          "type": "string"
        },
        "rotulo": {
          "default": "Segundo a imprensa",
          "title": "Rotulo",
          "type": "string"
        },
        "desfecho": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desfecho"
        },
        "atualizado_em": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atualizado Em"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "titulo_noticia": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Titulo Noticia"
        },
        "veiculo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Veiculo"
        },
        "data": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "noticia_id"
      ],
      "title": "Atribuicao",
      "type": "object"
    },
    "Bem": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "title": "Pid",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "valor": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Valor"
        },
        "ano_eleitoral": {
          "title": "Ano Eleitoral",
          "type": "integer"
        },
        "fonte": {
          "$ref": "#/$defs/Proveniencia_Decimal_"
        }
      },
      "required": [
        "pid",
        "descricao",
        "valor",
        "ano_eleitoral",
        "fonte"
      ],
      "title": "Bem",
      "type": "object"
    },
    "Despesa": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "title": "Pid",
          "type": "string"
        },
        "categoria": {
          "title": "Categoria",
          "type": "string"
        },
        "valor": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Valor"
        },
        "competencia": {
          "format": "date",
          "title": "Competencia",
          "type": "string"
        },
        "fonte": {
          "$ref": "#/$defs/Proveniencia_Decimal_"
        }
      },
      "required": [
        "pid",
        "categoria",
        "valor",
        "competencia",
        "fonte"
      ],
      "title": "Despesa",
      "type": "object"
    },
    "Doacao": {
      "additionalProperties": false,
      "properties": {
        "candidato_pid": {
          "title": "Candidato Pid",
          "type": "string"
        },
        "doador": {
          "title": "Doador",
          "type": "string"
        },
        "valor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Valor"
        },
        "ano_eleitoral": {
          "title": "Ano Eleitoral",
          "type": "integer"
        },
        "fonte": {
          "$ref": "#/$defs/Proveniencia_Decimal_"
        }
      },
      "required": [
        "candidato_pid",
        "doador",
        "valor",
        "ano_eleitoral",
        "fonte"
      ],
      "title": "Doacao",
      "type": "object"
    },
    "Emenda": {
      "additionalProperties": false,
      "properties": {
        "parlamentar_pid": {
          "title": "Parlamentar Pid",
          "type": "string"
        },
        "favorecido": {
          "title": "Favorecido",
          "type": "string"
        },
        "valor_empenhado": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Valor Empenhado"
        },
        "ano": {
          "title": "Ano",
          "type": "integer"
        },
        "fonte": {
          "$ref": "#/$defs/Proveniencia_Decimal_"
        }
      },
      "required": [
        "parlamentar_pid",
        "favorecido",
        "valor_empenhado",
        "ano",
        "fonte"
      ],
      "title": "Emenda",
      "type": "object"
    },
    "Filiacao": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "title": "Pid",
          "type": "string"
        },
        "partido_sigla": {
          "title": "Partido Sigla",
          "type": "string"
        },
        "inicio": {
          "format": "date",
          "title": "Inicio",
          "type": "string"
        },
        "fim": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fim"
        },
        "fonte": {
          "$ref": "#/$defs/Proveniencia_str_"
        }
      },
      "required": [
        "pid",
        "partido_sigla",
        "inicio",
        "fonte"
      ],
      "title": "Filiacao",
      "type": "object"
    },
    "Mandato": {
      "additionalProperties": false,
      "properties": {
        "poder": {
          "$ref": "#/$defs/Poder"
        },
        "cargo": {
          "title": "Cargo",
          "type": "string"
        },
        "uf": {
          "anyOf": [
            {
              "maxLength": 2,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uf"
        },
        "inicio": {
          "format": "date",
          "title": "Inicio",
          "type": "string"
        },
        "fim": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fim"
        },
        "status": {
          "$ref": "#/$defs/StatusMandato"
        },
        "titular_pid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Titular Pid"
        }
      },
      "required": [
        "poder",
        "cargo",
        "inicio",
        "status"
      ],
      "title": "Mandato",
      "type": "object"
    },
    "Partido": {
      "additionalProperties": false,
      "properties": {
        "sigla": {
          "maxLength": 32,
          "minLength": 2,
          "title": "Sigla",
          "type": "string"
        },
        "nome": {
          "title": "Nome",
          "type": "string"
        },
        "numero": {
          "anyOf": [
            {
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numero"
        },
        "federacao": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Federacao"
        },
        "historico_nomes": {
          "items": {
            "type": "string"
          },
          "title": "Historico Nomes",
          "type": "array"
        }
      },
      "required": [
        "sigla",
        "nome"
      ],
      "title": "Partido",
      "type": "object"
    },
    "PesquisaEleitoral": {
      "additionalProperties": false,
      "properties": {
        "registro_tse": {
          "title": "Registro Tse",
          "type": "string"
        },
        "instituto": {
          "title": "Instituto",
          "type": "string"
        },
        "cargo": {
          "title": "Cargo",
          "type": "string"
        },
        "data_divulgacao": {
          "format": "date",
          "title": "Data Divulgacao",
          "type": "string"
        },
        "margem_erro_pp": {
          "exclusiveMinimum": 0,
          "title": "Margem Erro Pp",
          "type": "number"
        },
        "confianca_pct": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Confianca Pct",
          "type": "number"
        },
        "percentual_candidato": {
          "maximum": 100,
          "minimum": 0,
          "title": "Percentual Candidato",
          "type": "number"
        },
        "fonte": {
          "$ref": "#/$defs/Proveniencia_str_"
        }
      },
      "required": [
        "registro_tse",
        "instituto",
        "cargo",
        "data_divulgacao",
        "margem_erro_pp",
        "confianca_pct",
        "percentual_candidato",
        "fonte"
      ],
      "title": "PesquisaEleitoral",
      "type": "object"
    },
    "Poder": {
      "enum": [
        "legislativo",
        "executivo",
        "judiciario"
      ],
      "title": "Poder",
      "type": "string"
    },
    "Posicionamento": {
      "additionalProperties": false,
      "properties": {
        "autodeclaracao": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proveniencia_str_"
