---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Página não encontrada · Praça">
  <div class="wrap page">
    <div class="hero" style="padding-block: var(--s-8);">
      <div class="hero-copy">
        <span class="eyebrow">404 · endereço não encontrado</span>
        <h1>Esta página saiu da Praça.</h1>
        <p class="lede">O endereço pode ter mudado ou não existir. Use uma das rotas principais abaixo.</p>
        <div class="card-actions">
          <a class="button" href="/">Ir para o início</a>
          <a class="button secondary" href="/pessoas">Explorar pessoas</a>
          <a class="button secondary" href="/busca">Buscar no Praça</a>
        </div>
      </div>
      <div class="callout" data-poder="judiciario">
        <span class="eyebrow">Também pode ajudar</span>
        <p>Confira a grafia do endereço ou consulte a página de metodologia e fontes para encontrar o caminho correto.</p>
        <a href="/metodologia">Metodologia →</a>
      </div>
    </div>
  </div>
</Layout>
